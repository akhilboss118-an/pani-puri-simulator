; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[android]

package/unique_name="com.panipurisimulator.game"
screen/support_normal=true
screen/support_large=true
screen/support_xlarge=true
user_data_backup/allow=false

[application]

config/name="Pani Puri Simulator"
config/description="Run a roadside pani puri stall on a living Indian street."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.109804, 0.078431, 0.062745, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Events="*res://scripts/core/events.gd"
Game="*res://scripts/core/game.gd"
Economy="*res://scripts/core/economy.gd"
Inventory="*res://scripts/core/inventory.gd"
Orders="*res://scripts/core/orders.gd"
Progression="*res://scripts/core/progression.gd"
Clock="*res://scripts/core/clock.gd"
Goals="*res://scripts/core/goals.gd"
Achievements="*res://scripts/core/achievements.gd"
SaveManager="*res://scripts/core/save_manager.gd"
Audio="*res://scripts/core/audio.gd"
EnvironmentLoader="*res://scripts/world/environment_loader.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
textures/vram_compression/environment/defaults/default_clear_color=Color(0.803922, 0.729412, 0.611765, 1)
